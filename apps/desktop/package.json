{
  "name": "@hmat-pharmacy/desktop",
  "version": "1.0.0",
  "description": "HMAT Pharmacy POS Enterprise Desktop Application",
  "author": "HMAT Pharmacy POS Team",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "build": "vite build",
    "vite:dev": "vite",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.hmatpharmacy.pos",
    "productName": "HMAT Pharmacy POS",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        "zip",
        "portable"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.435.0"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "^26.15.3",
    "vite": "^5.4.2",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^3.4.10",
    "postcss": "^8.4.41",
    "autoprefixer": "^10.4.20"
  }
}
